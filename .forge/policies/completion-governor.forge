#!forge/v1
forge_version: 1
schema_ref: urn:forgeroot:forge:policy:v1
kind: policy
id: forge://hiroshitanaka-creator/ForgeRoot/policy/completion-governor
revision: 01KZ0000000000000000000000
mind_ref: forge://hiroshitanaka-creator/ForgeRoot/mind/root
status: active
title: ForgeRoot Completion Governor Policy
summary: Prevent ForgeRoot completion work from drifting into docs-only, manifest-only, or review-debt-heavy PRs while the repository is being finished.
owners:
  - github://hiroshitanaka-creator
  - github-app://forgeroot
created_at: 2026-07-05T00:00:00Z
updated_at: 2026-07-05T00:00:00Z
policy_type: completion-governor
rules:
  - id: implementation-or-governance-required
    statement: "Completion-mode PRs must change at least one implementation or enforceable governance artifact unless an explicit docs-only approval label is present."
    required_approval_class: C
  - id: verification-evidence-required
    statement: "Implementation and governance PRs must record a command, passing result, and current head commit in the PR body."
    required_approval_class: C
  - id: codex-review-debt-zero
    statement: "Active Codex P1/P2 review debt must be zero across open PRs before completion work can merge."
    required_approval_class: C
  - id: manifest-only-work-requires-approval
    statement: "Manifest-only, dry-run-only, proposal-only, and docs-only work is blocked unless an explicit approval label is present."
    required_approval_class: C
thresholds:
  max_active_codex_threads: 3
  max_active_codex_p1_or_p0: 0
  max_active_codex_p2: 0
  max_docs_line_ratio: 0.4
  max_docs_files_when_implementation_exists: 3
  min_implementation_or_governance_files: 1
actions_on_breach:
  implementation-or-governance-required:
    - reject_change
    - require_executable_artifact
  verification-evidence-required:
    - reject_change
    - require_current_head_verification
  codex-review-debt-zero:
    - reject_change
    - collapse_review_debt
  manifest-only-work-requires-approval:
    - reject_change
    - require_manifest_only_approval_label
required_approvals:
  C:
    summary: workflows, policies, completion gates, and review-debt enforcement
    min_human_approvals: 2
    auto_pr_allowed: false
    codeowner_required: true
cooldowns:
  restore_requires_human_ack_after_step: 2
quarantine_triggers:
  - unresolved_codex_p1_or_p2
  - stale_verification_evidence
  - docs_only_drift
  - manifest_only_without_override
provenance:
  seed_task: PR-16
  seed_basis:
    - .github/workflows/forge-pr-governor.yml
    - .agents/skills/repository-finisher/SKILL.md
  created_by: github://hiroshitanaka-creator
extensions:
  approved_labels:
    docs_only:
      - governor/docs-only-approved
      - docs-only-approved
    manifest_only:
      - governor/manifest-only-approved
      - manifest-only-approved
  completion_bias:
    - prefer executable source over prose
    - prefer tests over status reports
    - prefer current PR repair over next PR creation
    - prefer real branch, worktree, sandbox, and transport behavior over new proposal surfaces
